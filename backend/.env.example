# Google Gemini API Key
# Obtain one from Google AI Studio: https://aistudio.google.com/
GOOGLE_GEMINI_KEY=your_gemini_api_key_here

# Server Port (Default is 3000)
PORT=3000

# Allowed Frontend URL for Secure CORS Restriction
CLIENT_URL=https://ai-code-review-frontend-six.vercel.app

# Optional Model Override (Defaults to gemini-flash-lite-latest)
# Options: gemini-flash-lite-latest, gemini-3.5-flash-lite, gemini-3.8-flash
GEMINI_MODEL=gemini-flash-lite-latest
